# ==============================================================================
# AI Zodiac Web - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local development.
# NEVER commit real credentials, tokens, or API keys to git repository.
# For Cloudflare Workers deployment, non-sensitive variables are defined in `wrangler.toml`
# and secrets (e.g. GROQ_API_KEY) are set via `wrangler secret put <KEY>`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Configuration
# ------------------------------------------------------------------------------
# Production or staging site URL (e.g., https://aizodiac.workers.dev)
SITE_URL=https://aizodiac.workers.dev

# Optional: Cloudflare Web Analytics Token (beacon token for privacy-friendly analytics)
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# ------------------------------------------------------------------------------
# 2. Groq Text Generation Configuration (Content System)
# ------------------------------------------------------------------------------
# Groq API Key (from https://console.groq.com/keys)
# Set via: wrangler secret put GROQ_API_KEY
GROQ_API_KEY=

# Groq Model Identifier (Planned: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Media Storage (Native binding: MEDIA_BUCKET)
# ------------------------------------------------------------------------------
# Dedicated R2 bucket name in AI Zodiac Cloudflare account: aizodiac-assets
# Native binding configured in wrangler.toml as `MEDIA_BUCKET` (no S3 credentials needed)
R2_BUCKET_NAME=aizodiac-assets

# Public Base URL for serving assets (custom domain or r2.dev dev subdomain)
R2_PUBLIC_BASE_URL=https://assets.aizodiac.workers.dev

# ------------------------------------------------------------------------------
# 4. Cloudflare Workers AI - Image Generation (Native binding: AI)
# ------------------------------------------------------------------------------
# Native binding configured in wrangler.toml as `AI` (no API token needed)
# Target FLUX image model on Cloudflare Workers AI
WORKERS_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ------------------------------------------------------------------------------
# 5. Cost Protection & Generation Limits (Conservative Defaults)
# ------------------------------------------------------------------------------
# Application-level circuit breakers to safeguard against runaway API dispatch.
# Authoritative allocation is governed directly by Cloudflare / Groq account limits.
AI_DAILY_TEXT_LIMIT=50
AI_MONTHLY_TEXT_LIMIT=1000
AI_DAILY_IMAGE_LIMIT=20
AI_MONTHLY_IMAGE_LIMIT=400
AI_MAX_ARTICLE_LENGTH_TOKENS=3500
