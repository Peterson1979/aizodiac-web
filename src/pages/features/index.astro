---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FEATURE_PAGES } from '@/types/content';
import { buildCanonicalUrl } from '@/lib/seo/meta';
import { buildPlayStoreUrl } from '@/lib/conversion/playStore';

const pageUrl = buildCanonicalUrl('features');

const featuresHubPlayStoreUrl = buildPlayStoreUrl({
  utmSource: 'website',
  utmMedium: 'feature_showcase',
  utmCampaign: 'features_hub',
  utmContent: 'hub_bottom_banner',
});
---

<BaseLayout
  title="AI Astrology App Features — AI Zodiac"
  description="Explore the features of the AI Zodiac app: Personalized Horoscopes, Ascendant Calculator, Zodiac Traits, Love Compatibility, AI Astrologer, Numerology, Chinese Zodiac, and Astro Calendar."
  canonicalUrl={pageUrl}
>
  <div class="features-hub-page container">
    <!-- Header -->
    <header class="hub-header">
      <div class="badge-wrap">
        <span class="badge badge-gold">✦ Astrological Intelligence</span>
      </div>
      <h1 class="page-title">
        AI Zodiac <span class="gradient-text">Features</span>
      </h1>
      <p class="page-subtitle">
        Discover personalized astrology insights with AI Zodiac, an AI-powered horoscope and zodiac app designed to help you explore your sign, relationships, personality, and astrological timing.
      </p>
    </header>

    <!-- Features Grid -->
    <div class="features-list-grid">
      {FEATURE_PAGES.map((feature, idx) => (
        <article class="glass-card feature-hub-card">
          <div class="card-top">
            <div class="icon-box-lg">
              <img src={feature.icon} alt={feature.title} class="icon-img-lg" width="80" height="80" loading="lazy" />
            </div>
            <span class="feature-idx">0{idx + 1}</span>
          </div>

          <h2 class="feature-title">
            <a href={`/features/${feature.slug}`} class="feature-link">
              {feature.title}
            </a>
          </h2>

          <p class="feature-tagline">{feature.tagline}</p>
          <p class="feature-desc">{feature.userBenefit}</p>

          <div class="card-footer">
            <a href={`/features/${feature.slug}`} class="learn-more-btn" aria-label={`Explore ${feature.title}`}>
              Explore Feature <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- App CTA Banner -->
    <section class="hub-cta-section">
      <div class="glass-card cta-banner">
        <div class="cta-brand">
          <img src="/images/aizodiac_logo.png" alt="AI Zodiac App Icon" width="48" height="48" class="cta-logo-img" loading="lazy" />
        </div>
        <span class="badge badge-gold">AI Zodiac Android App</span>
        <h2 class="cta-heading">Get Started with the AI Zodiac App</h2>
        <p class="cta-text">
          Download AI Zodiac for Android to explore daily, weekly, and monthly horoscope forecasts, calculate your ascendant, check love compatibility, and ask the AI astrologer your questions.
        </p>
        <div class="cta-btn-wrap">
          <a
            href={featuresHubPlayStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-play"
            aria-label="Get AI Zodiac App on Google Play"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
            </svg>
            <div class="btn-play-text">
              <span class="btn-play-sub">GET IT ON</span>
              <span class="btn-play-main">Google Play</span>
            </div>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .features-hub-page {
    padding: 4rem 1.5rem 6rem;
  }

  .hub-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem;
  }

  .badge-wrap {
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Grid */
  .features-list-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-bottom: 5rem;
  }

  .feature-hub-card {
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .feature-icon {
    font-size: 2rem;
  }

  .feature-idx {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .feature-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
  }

  .feature-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .feature-link:hover {
    color: var(--accent-cyan);
  }

  .feature-tagline {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--accent-gold);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .feature-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .learn-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .learn-more-btn:hover {
    color: #7dd3fc;
    transform: translateX(4px);
  }

  /* CTA Banner */
  .hub-cta-section {
    margin-top: 2rem;
  }

  .cta-banner {
    text-align: center;
    padding: 3.5rem 2rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.5) 0%, rgba(16, 22, 47, 0.85) 100%);
    border: 1px solid var(--border-active);
  }

  .cta-brand {
    margin-bottom: 1.25rem;
  }

  .cta-logo-img {
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(139, 92, 246, 0.35);
  }

  .cta-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .cta-text {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
  }

  .cta-btn-wrap {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
</style>
