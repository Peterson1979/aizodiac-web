---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FEATURE_PAGES, type FeaturePageData } from '@/types/content';
import { buildCanonicalUrl } from '@/lib/seo/meta';
import { siteConfig } from '@/config/site';

export function getStaticPaths() {
  return FEATURE_PAGES.map((feature) => ({
    params: { slug: feature.slug },
    props: { feature },
  }));
}

interface Props {
  readonly feature: FeaturePageData;
}

const { feature } = Astro.props;
const pageUrl = buildCanonicalUrl(`features/${feature.slug}`);

const featureJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `AI Zodiac — ${feature.title}`,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  description: feature.description,
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.getBaseUrl(),
  },
};
---

<BaseLayout
  title={feature.seoTitle}
  description={feature.seoDescription}
  canonicalUrl={pageUrl}
  jsonLd={featureJsonLd}
>
  <div class="feature-detail-page container">
    <!-- Breadcrumb -->
    <nav class="feature-breadcrumb" aria-label="Breadcrumb">
      <a href="/features" class="breadcrumb-back">
        <span>←</span> All Features
      </a>
      <span class="divider">/</span>
      <span class="current-feature">{feature.title}</span>
    </nav>

    <!-- Hero Header -->
    <header class="feature-hero">
      <div class="feature-icon-badge">
        <span class="icon-glyph">{feature.icon}</span>
      </div>
      <h1 class="feature-hero-title">
        {feature.title}
      </h1>
      <p class="feature-hero-tagline">
        {feature.tagline}
      </p>

      <!-- User Benefit Highlight Card -->
      <div class="glass-card benefit-card">
        <div class="benefit-label">
          <span class="badge badge-gold">Key User Benefit</span>
        </div>
        <p class="benefit-text">{feature.userBenefit}</p>
      </div>
    </header>

    <!-- In-Depth Explanation Section -->
    <section class="feature-overview-section">
      <div class="overview-content">
        <h2 class="section-title">How It Works in AI Zodiac</h2>
        <p class="overview-p">{feature.description}</p>
      </div>

      <!-- Example Use Cases -->
      <div class="use-cases-wrap">
        <h3 class="subsection-title">Real-Life Application & Focus Areas</h3>
        <div class="use-cases-grid">
          {feature.exampleUseCases.map((useCase, idx) => (
            <div class="glass-card use-case-card">
              <span class="use-case-num">0{idx + 1}</span>
              <h4 class="use-case-title">{useCase.title}</h4>
              <p class="use-case-desc">{useCase.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Mobile App Value Highlights -->
    <section class="app-value-section">
      <div class="glass-card app-value-card">
        <div class="value-header">
          <span class="badge">AI Zodiac Mobile Advantage</span>
          <h3 class="value-title">What You Get in the Android App</h3>
        </div>

        <ul class="value-list">
          {feature.appValueHighlights.map((highlight) => (
            <li class="value-item">
              <span class="check-icon">✓</span>
              <span class="value-text">{highlight}</span>
            </li>
          ))}
        </ul>

        <!-- Conversion CTA Area -->
        <div class="app-conversion-box">
          <h4 class="conversion-heading">Continue Your Personalized Journey</h4>
          <p class="conversion-sub">
            The full interactive computational engine, transit updates, and chart calculations are delivered natively in the mobile application.
          </p>

          <div class="conversion-actions">
            <a href="/#features" class="btn btn-primary app-cta-btn">
              <span>Continue in AI Zodiac App</span>
              <span class="btn-arrow">→</span>
            </a>
            <a href="/articles" class="btn btn-secondary">
              Read Astrology Guides
            </a>
          </div>

          <span class="conversion-note">
            Free to download on Google Play • Personalized to your exact birth data
          </span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .feature-detail-page {
    max-width: 860px;
    padding: 3.5rem 1.5rem 6rem;
  }

  /* Breadcrumb */
  .feature-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .breadcrumb-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-back:hover {
    color: var(--accent-cyan);
  }

  .divider {
    color: var(--border-subtle);
  }

  .current-feature {
    color: var(--accent-gold);
    font-weight: 500;
  }

  /* Hero */
  .feature-hero {
    text-align: center;
    margin-bottom: 4rem;
  }

  .feature-icon-badge {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .feature-hero-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .feature-hero-tagline {
    font-size: 1.1875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  /* Benefit Card */
  .benefit-card {
    text-align: left;
    padding: 1.75rem 2rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.5) 0%, rgba(16, 22, 47, 0.8) 100%);
    border: 1px solid var(--border-active);
  }

  .benefit-label {
    margin-bottom: 0.75rem;
  }

  .benefit-text {
    font-size: 1.0625rem;
    color: var(--text-primary);
    line-height: 1.65;
    font-weight: 500;
  }

  /* Overview Section */
  .feature-overview-section {
    margin-bottom: 4.5rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .overview-p {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 3rem;
  }

  .subsection-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .use-cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .use-case-card {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .use-case-num {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-gold);
    margin-bottom: 0.75rem;
  }

  .use-case-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
    color: var(--text-primary);
  }

  .use-case-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* App Value Section */
  .app-value-section {
    margin-top: 2rem;
  }

  .app-value-card {
    padding: 3rem 2.5rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.45) 0%, rgba(16, 22, 47, 0.9) 100%);
    border: 1px solid var(--border-active);
  }

  .value-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .value-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 0.75rem;
  }

  .value-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 640px;
    margin: 0 auto 3.5rem;
  }

  .value-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.15);
    color: #86efac;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .value-text {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* Conversion Box */
  .app-conversion-box {
    text-align: center;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .conversion-heading {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .conversion-sub {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .conversion-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .app-cta-btn {
    padding: 0.85rem 1.75rem;
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
  }

  .app-cta-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  .conversion-note {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
