---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { WESTERN_ZODIAC_SIGNS, FEATURE_PAGES, CONTENT_CLUSTERS, type ContentCluster } from '@/types/content';
import { siteConfig } from '@/config/site';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const featuredArticles = articles
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime())
  .slice(0, 3);

const clusterMap = new Map(CONTENT_CLUSTERS.map((c) => [c.id, c]));
---

<BaseLayout
  title="AI Zodiac — AI Astrology App & Personalized Horoscope"
  description="AI Zodiac is your personal AI astrology app. Discover personalized horoscopes, ascendant calculations, love compatibility, numerology, and conversational AI guidance on Android."
>
  <!-- Hero Section with Galaxy Backdrop -->
  <section class="hero-section galaxy-backdrop">
    <div class="hero-overlay"></div>
    <div class="container hero-container">
      <div class="hero-badge-wrap">
        <span class="badge badge-gold">
          <span class="pulse-dot"></span>
          Personalized Astrological Intelligence
        </span>
      </div>

      <h1 class="hero-title">
        Personalized AI Astrology Insights Based on Your <span class="gradient-text">Birth Data</span>
      </h1>

      <p class="hero-subtitle">
        Discover personalized astrology insights with AI Zodiac, an AI-powered horoscope and zodiac app designed to help you explore your sign, relationships, personality, and astrological timing.
      </p>

      <!-- Primary App Download & Exploration Actions -->
      <div class="hero-actions">
        <a
          href={siteConfig.googlePlayUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-play hero-play-btn"
          aria-label="Get AI Zodiac App on Google Play"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
          </svg>
          <div class="btn-play-text">
            <span class="btn-play-sub">GET IT ON</span>
            <span class="btn-play-main">Google Play</span>
          </div>
        </a>

        <a href="#zodiac" class="btn btn-secondary hero-secondary-btn">
          <span>Explore Your Zodiac Insights</span>
          <span>→</span>
        </a>
      </div>

      <!-- Zodiac Signs Interactive Strip -->
      <div id="zodiac" class="signs-strip-wrap">
        <div class="strip-header">
          <span class="strip-label">Explore the 12 Zodiac Archetypes</span>
          <a href="/tools/zodiac-sign" class="strip-finder-link">Calculate Your Sign →</a>
        </div>

        <div class="signs-grid" aria-label="Zodiac Signs">
          {WESTERN_ZODIAC_SIGNS.map((sign) => (
            <a
              href={`/tools/zodiac-sign?sign=${sign.id}`}
              class="sign-card"
              title={`${sign.name} (${sign.dateRange}) • Element: ${sign.element}`}
            >
              <img
                src={sign.iconUrl}
                alt={`${sign.name} Zodiac Icon`}
                width="40"
                height="40"
                class="sign-icon-img"
                loading="lazy"
              />
              <div class="sign-meta">
                <span class="sign-name">{sign.name}</span>
                <span class="sign-date">{sign.dateRange}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Core App Features Section -->
  <section id="features" class="core-values-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">AI Zodiac Android App</span>
        <h2 class="section-title">Personalized Astrology Insights</h2>
        <p class="section-desc">
          Get daily, weekly, monthly, and yearly horoscope forecasts, explore your zodiac sign, calculate your ascendant, check love compatibility, discover numerology and Chinese zodiac insights, and ask the AI astrologer your own questions.
        </p>
      </div>

      <div class="core-values-grid">
        {FEATURE_PAGES.map((feature, idx) => (
          <article class={`glass-card core-value-card ${idx === 0 || idx === 1 ? 'featured-card' : ''}`}>
            <div class="card-header-row">
              <div class="icon-box-lg">
                <img src={feature.icon} alt={`${feature.title} Icon`} width="52" height="52" class="icon-img-lg" loading="lazy" />
              </div>
              <span class="badge badge-feature-idx">0{idx + 1}</span>
            </div>
            <h3 class="core-title">{feature.title}</h3>
            <p class="core-desc">{feature.userBenefit}</p>
            <div class="card-bottom">
              <a href={`/features/${feature.slug}`} class="core-link" aria-label={`Learn more about ${feature.title}`}>
                <span>Explore Feature Details</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Free Tools Discovery Section -->
  <section class="free-tools-section">
    <div class="container">
      <div class="tools-teaser-card glass-card">
        <div class="tools-teaser-content">
          <span class="badge badge-gold">✦ Free Web Calculators</span>
          <h2 class="teaser-title">Start Exploring with Instant Astrological Tools</h2>
          <p class="teaser-desc">
            Try our lightweight calculators to find your zodiac sign, preview elemental compatibility between two signs, or explore your astrological profile.
          </p>
          <div class="teaser-actions">
            <a href="/tools/zodiac-sign" class="btn btn-secondary">Zodiac Finder</a>
            <a href="/tools/compatibility" class="btn btn-secondary">Compatibility</a>
            <a href="/tools/birth-chart" class="btn btn-secondary">Chart Preview</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Insights & Guides -->
  <section id="insights" class="insights-section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Astrology Guides & Authority</span>
        <h2 class="section-title">Grounded Astrological Knowledge</h2>
        <p class="section-desc">
          Educational perspectives on natal astrology, zodiac personality patterns, relationship dynamics, and mindful self-discovery.
        </p>
      </div>

      <div class="articles-grid">
        {featuredArticles.map((article) => {
          const clusterInfo = clusterMap.get(article.data.cluster as ContentCluster);
          const slug = article.id.replace(/\.[^/.]+$/, "");
          return (
            <article class="glass-card article-card">
              <div class="article-card-header">
                <span class="cluster-tag">
                  {clusterInfo?.icon && (
                    <img src={clusterInfo.icon} alt="" width="20" height="20" class="cluster-tag-img" />
                  )}
                  <span>{clusterInfo?.name || article.data.cluster}</span>
                </span>
                <span class="reading-time">{article.data.readingTime}</span>
              </div>

              <h3 class="article-title">
                <a href={`/articles/${slug}`} class="article-link">
                  {article.data.title}
                </a>
              </h3>

              <p class="article-desc">
                {article.data.description}
              </p>

              <div class="article-footer">
                <span class="topic-label">{article.data.topic}</span>
                <a href={`/articles/${slug}`} class="read-more-link" aria-label={`Read ${article.data.title}`}>
                  Read Guide <span>→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <div class="view-all-wrap">
        <a href="/articles" class="btn btn-secondary">
          Explore All Astrology Guides →
        </a>
      </div>
    </div>
  </section>

  <!-- Primary Conversion Banner Section -->
  <section id="download" class="download-section galaxy-backdrop">
    <div class="container">
      <div class="glass-card download-card">
        <div class="download-brand">
          <img src="/images/aizodiac_logo.png" alt="AI Zodiac App Icon" width="64" height="64" class="app-icon-img" />
        </div>
        <span class="badge badge-gold">AI Zodiac for Android</span>
        <h2 class="download-title">
          Get Started with the <span class="gradient-text">AI Zodiac App</span>
        </h2>
        <p class="download-desc">
          Download AI Zodiac for Android to explore personalized daily horoscopes, calculate your ascendant, discover love compatibility, and receive personalized AI guidance.
        </p>

        <div class="download-actions">
          <a
            href={siteConfig.googlePlayUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-play download-cta"
            aria-label="Get AI Zodiac App on Google Play"
          >
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
            </svg>
            <div class="btn-play-text">
              <span class="btn-play-sub">GET IT ON</span>
              <span class="btn-play-main">Google Play</span>
            </div>
          </a>
        </div>

        <p class="download-note">
          Free download on Google Play • Personalized to your unique zodiac profile and birth details
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 4.5rem 0 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, rgba(139, 92, 246, 0.14) 0%, rgba(9, 12, 25, 0.92) 70%);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-wrap {
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 10px #f59e0b;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.85rem);
    font-weight: 800;
    max-width: 920px;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    max-width: 780px;
    margin-bottom: 2.5rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-bottom: 3.5rem;
  }

  .hero-play-btn {
    padding: 0.85rem 2rem;
  }

  .hero-secondary-btn {
    padding: 0.85rem 1.75rem;
  }

  /* Signs Strip Grid */
  .signs-strip-wrap {
    width: 100%;
    max-width: 1100px;
    margin-top: 1rem;
    background: rgba(16, 22, 47, 0.55);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    backdrop-filter: blur(16px);
  }

  .strip-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .strip-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
  }

  .strip-finder-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .strip-finder-link:hover {
    color: #7dd3fc;
  }

  .signs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
  }

  .sign-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-glass);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .sign-card:hover {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.4);
    transform: translateY(-2px);
  }

  .sign-icon-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .sign-meta {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .sign-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .sign-date {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    margin-top: 1rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Core Values Grid */
  .core-values-section {
    padding: 5.5rem 0 3.5rem;
  }

  .core-values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .core-value-card {
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
  }

  .featured-card {
    border-color: rgba(139, 92, 246, 0.35);
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.6) 0%, rgba(16, 22, 47, 0.85) 100%);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .badge-feature-idx {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .core-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .core-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .card-bottom {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .core-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .core-link:hover {
    color: #7dd3fc;
    transform: translateX(4px);
  }

  /* Tools Teaser Card */
  .free-tools-section {
    padding: 2.5rem 0;
  }

  .tools-teaser-card {
    padding: 3.5rem 2.5rem;
    text-align: center;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.45) 0%, rgba(16, 22, 47, 0.85) 100%);
    border: 1px solid var(--border-active);
  }

  .teaser-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .teaser-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 660px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
  }

  .teaser-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Articles Section */
  .insights-section {
    padding: 5rem 0 6rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
  }

  .article-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .cluster-tag {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-gold);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cluster-tag-img {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .reading-time {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .article-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.85rem;
  }

  .article-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-link:hover {
    color: var(--accent-cyan);
  }

  .article-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .topic-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .read-more-link:hover {
    color: #7dd3fc;
    transform: translateX(3px);
  }

  .view-all-wrap {
    text-align: center;
  }

  /* Download / Conversion Section */
  .download-section {
    padding: 4rem 0 6rem;
  }

  .download-card {
    text-align: center;
    padding: 4.5rem 2rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.75) 0%, rgba(16, 22, 47, 0.95) 100%);
    border: 1px solid var(--border-active);
    box-shadow: var(--shadow-glow);
  }

  .download-brand {
    margin-bottom: 1.5rem;
  }

  .app-icon-img {
    border-radius: var(--radius-md);
    box-shadow: 0 4px 24px rgba(139, 92, 246, 0.35);
  }

  .download-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .download-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .download-actions {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .download-cta {
    padding: 0.85rem 2.25rem;
  }

  .download-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3rem 0 2.5rem;
    }
    .core-values-grid {
      grid-template-columns: 1fr;
    }
    .core-value-card {
      padding: 1.75rem 1.5rem;
    }
    .tools-teaser-card {
      padding: 2.5rem 1.5rem;
    }
    .download-card {
      padding: 3rem 1.5rem;
    }
  }
</style>
