---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { TOOLS_LIST } from '@/types/content';
import { buildCanonicalUrl } from '@/lib/seo/meta';
import { buildPlayStoreUrl } from '@/lib/conversion/playStore';

const pageUrl = buildCanonicalUrl('tools');

const toolsHubPlayStoreUrl = buildPlayStoreUrl({
  utmSource: 'website',
  utmMedium: 'tool',
  utmCampaign: 'tools_hub',
  utmContent: 'hub_callout_cta',
});
---

<BaseLayout
  title="Free Astrological Tools & Zodiac Calculators — AI Zodiac"
  description="Explore free, instant astrological calculators: find your zodiac sign, check elemental compatibility, and preview your birth chart dimensions."
  canonicalUrl={pageUrl}
>
  <div class="tools-hub-page container">
    <!-- Header -->
    <header class="hub-header">
      <div class="badge-wrap">
        <span class="badge badge-gold">Interactive Astrology</span>
      </div>
      <h1 class="page-title">
        Astrological <span class="gradient-text">Tools & Calculators</span>
      </h1>
      <p class="page-subtitle">
        Free, lightweight exploratory tools to discover your zodiac sign, test elemental compatibility, and preview your astrological profile.
      </p>
    </header>

    <!-- Tools Grid -->
    <div class="tools-grid">
      {TOOLS_LIST.map((tool) => (
        <article class="glass-card tool-card">
          <div class="icon-box-lg" style="margin-bottom: 1.5rem;">
            <img src={tool.icon} alt={tool.title} class="icon-img-lg" width="80" height="80" loading="lazy" />
          </div>
          <h2 class="tool-title">{tool.title}</h2>
          <p class="tool-tagline">{tool.tagline}</p>
          <p class="tool-desc">{tool.description}</p>

          <ul class="tool-feature-list">
            {tool.features.map((feat) => (
              <li>
                <span class="bullet">✦</span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="tool-btn-wrap">
            <a href={`/tools/${tool.slug}`} class="btn btn-primary tool-cta-btn">
              Launch {tool.title} →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Cross-Linking to Canonical Hubs -->
    <section class="tools-hubs-crosslink">
      <h2 class="hubs-crosslink-title">Explore Related Astrology Hubs</h2>
      <div class="hubs-crosslink-grid">
        <a href="/zodiac-signs" class="glass-card hub-link-card">
          <span class="hub-card-badge">Zodiac Hub</span>
          <h3 class="hub-card-title">12 Zodiac Signs →</h3>
          <p class="hub-card-desc">Detailed personality archetypes, strengths, and ruling planets.</p>
        </a>
        <a href="/compatibility" class="glass-card hub-link-card">
          <span class="hub-card-badge">Synastry Hub</span>
          <h3 class="hub-card-title">Zodiac Compatibility →</h3>
          <p class="hub-card-desc">Elemental dynamics, love harmonies, and communication styles.</p>
        </a>
        <a href="/horoscopes" class="glass-card hub-link-card">
          <span class="hub-card-badge">Forecasts</span>
          <h3 class="hub-card-title">Horoscopes &amp; Timing →</h3>
          <p class="hub-card-desc">Daily, weekly, monthly, and yearly astrological guidance.</p>
        </a>
      </div>
    </section>

    <!-- App Integration Callout -->
    <section class="tools-app-callout">
      <div class="glass-card callout-card">
        <div class="callout-brand">
          <img src="/images/aizodiac_logo.png" alt="AI Zodiac App" width="48" height="48" class="callout-logo-img" loading="lazy" />
        </div>
        <span class="badge badge-gold">AI Zodiac for Android</span>
        <h2 class="callout-title">Unlock Full Astrological Insights in the App</h2>
        <p class="callout-desc">
          While our free web tools provide quick baseline previews, the AI Zodiac Android app offers personalized daily forecasts, ascendant calculations, love compatibility, and conversational AI guidance.
        </p>
        <div class="callout-actions">
          <a
            href={toolsHubPlayStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-play callout-play-btn"
            data-location="tools_hub"
            aria-label="Get AI Zodiac App on Google Play"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
            </svg>
            <div class="btn-play-text">
              <span class="btn-play-sub">GET IT ON</span>
              <span class="btn-play-main">Google Play</span>
            </div>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tools-hub-page {
    padding: 4rem 1.5rem 6rem;
  }

  .hub-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem;
  }

  .badge-wrap {
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Tools Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 5rem;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 2.5rem 2rem;
  }

  .tool-icon-box {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .tool-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .tool-tagline {
    font-size: 0.9375rem;
    color: var(--accent-gold);
    font-weight: 500;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .tool-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .tool-feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 2rem;
    flex: 1;
  }

  .tool-feature-list li {
    font-size: 0.8125rem;
    color: var(--text-muted);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .bullet {
    color: var(--accent-cyan);
    font-size: 0.65rem;
    margin-top: 3px;
  }

  .tool-btn-wrap {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tool-cta-btn {
    width: 100%;
  }

  /* Hubs Crosslink */
  .tools-hubs-crosslink {
    margin: 4rem 0 2rem;
  }

  .hubs-crosslink-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .hubs-crosslink-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .hub-link-card {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: all var(--transition-fast);
  }

  .hub-link-card:hover {
    border-color: var(--border-active);
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow);
  }

  .hub-card-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-gold);
  }

  .hub-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .hub-link-card:hover .hub-card-title {
    color: var(--accent-cyan);
  }

  .hub-card-desc {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hubs-crosslink-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Callout */
  .tools-app-callout {
    margin-top: 2rem;
  }

  .callout-card {
    text-align: center;
    padding: 3.5rem 2rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.5) 0%, rgba(16, 22, 47, 0.9) 100%);
    border: 1px solid var(--border-active);
  }

  .callout-brand {
    margin-bottom: 1.25rem;
  }

  .callout-logo-img {
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(139, 92, 246, 0.35);
  }

  .callout-title {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    margin-bottom: 1rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .callout-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
  }

  .callout-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
</style>
