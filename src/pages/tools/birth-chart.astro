---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WESTERN_ZODIAC_SIGNS } from '@/types/content';
import { buildCanonicalUrl } from '@/lib/seo/meta';
import { siteConfig } from '@/config/site';

const pageUrl = buildCanonicalUrl('tools/birth-chart');

const toolJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'AI Zodiac Birth Chart Preview',
  url: pageUrl,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  description: 'Preview your natal birth chart blueprint, understand the 12 astrological houses, and discover how birth data creates a celestial map.',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
};

const CHART_CATEGORIES = [
  { num: '1st', title: 'Self & Persona', focus: 'Rising sign, physical vitality, outward presence, personal agency' },
  { num: '2nd', title: 'Values & Resources', focus: 'Tangible security, earned income, personal talents, material foundation' },
  { num: '3rd', title: 'Mind & Environment', focus: 'Immediate communication, learning habits, siblings, local community' },
  { num: '4th', title: 'Home & Roots', focus: 'Family origins, emotional foundation, private sanctuary, psychological roots' },
  { num: '5th', title: 'Joy & Self-Expression', focus: 'Creative vitality, romance, passion projects, spontaneous play' },
  { num: '6th', title: 'Daily Rhythm & Wellness', focus: 'Daily routines, physical wellness, craftsmanship, intentional service' },
  { num: '7th', title: 'Partnership & Balance', focus: 'Committed relationships, deep collaboration, marriage, relational contracts' },
  { num: '8th', title: 'Transformation & Bonds', focus: 'Shared resources, emotional vulnerability, regenerative psychological depth' },
  { num: '9th', title: 'Philosophy & Expansion', focus: 'Higher wisdom, travel, world exploration, ethical frameworks' },
  { num: '10th', title: 'Career & Legacy', focus: 'Public reputation, vocation, long-term mastery, societal contribution' },
  { num: '11th', title: 'Community & Vision', focus: 'Collective ideals, friendship circles, futuristic innovation, group alliances' },
  { num: '12th', title: 'Subconscious & Rest', focus: 'Inner spiritual sanctuary, dreams, subconscious integration, surrender' },
];
---

<BaseLayout
  title="Birth Chart Interpretation & Natal Blueprint Preview — AI Zodiac"
  description="Explore the structural dimensions of your natal birth chart. Understand planetary placements, the Big Three, and 12 astrological houses."
  canonicalUrl={pageUrl}
  jsonLd={toolJsonLd}
>
  <div class="tool-page container">
    <!-- Breadcrumb -->
    <nav class="tool-breadcrumb" aria-label="Breadcrumb">
      <a href="/tools" class="breadcrumb-link">
        <span>←</span> All Tools
      </a>
      <span class="divider">/</span>
      <span class="current">Birth Chart Preview</span>
    </nav>

    <!-- Header -->
    <header class="tool-header">
      <div class="badge-wrap">
        <span class="badge badge-gold">✦ Free Natal Blueprint Preview</span>
      </div>
      <h1 class="tool-title">
        Birth Chart <span class="gradient-text">Preview</span>
      </h1>
      <p class="tool-subtitle">
        Enter your birth details to preview your celestial blueprint, discover your baseline Sun sign archetype, and understand the structural dimensions of a complete natal chart.
      </p>
    </header>

    <!-- Interactive Preview Form Card -->
    <div class="glass-card calculator-card">
      <form id="chart-form" class="chart-form">
        <div class="form-row">
          <div class="form-group">
            <label for="chart-date" class="form-label">Birth Date (Required)</label>
            <input type="date" id="chart-date" class="form-input" required />
          </div>

          <div class="form-group">
            <label for="chart-time" class="form-label">Birth Time (Optional)</label>
            <input type="time" id="chart-time" class="form-input" placeholder="e.g. 14:30" />
            <span class="input-hint">Used for exact Ascendant & house cusp calculation</span>
          </div>

          <div class="form-group">
            <label for="chart-location" class="form-label">Birth Location (Optional)</label>
            <input type="text" id="chart-location" class="form-input" placeholder="e.g. London, UK or New York, NY" />
            <span class="input-hint">Determines geographic coordinate offsets</span>
          </div>
        </div>

        <button type="submit" class="btn btn-primary chart-submit-btn">
          Generate Chart Preview <span>→</span>
        </button>
      </form>

      <!-- Preview Output Container -->
      <div id="chart-result" class="chart-result-box" style="display: none;">
        <div class="chart-banner">
          <img id="chart-sign-icon" src="/images/ic_aries.png" alt="Core Sun Sign Icon" width="56" height="56" class="chart-sign-icon" />
          <div class="chart-title-wrap">
            <h2 id="chart-sun-heading" class="chart-sun-name">Your Core Sun Sign: Aries</h2>
            <span id="chart-date-display" class="chart-date-text">March 21</span>
          </div>
        </div>

        <div class="preview-explanation">
          <h3 class="expl-title">What a Complete Birth Chart Reveals</h3>
          <p class="expl-text">
            Your birth date establishes your conscious Sun archetype, but an authentic natal chart is a three-dimensional map consisting of <strong class="highlight-text">10 planetary bodies</strong>, <strong class="highlight-text">12 life arenas (houses)</strong>, and <strong class="highlight-text">mathematical angular aspects</strong>.
          </p>
        </div>

        <!-- Three Core Tiers -->
        <div class="tiers-grid">
          <div class="glass-card tier-card">
            <span class="tier-num">Tier 1</span>
            <h4 class="tier-title">☀️ The Luminaries (Identity Core)</h4>
            <p class="tier-desc">
              Your <strong>Sun</strong> (conscious purpose), <strong>Moon</strong> (emotional needs), and <strong>Rising Sign / Ascendant</strong> (outer lens & physical vitality).
            </p>
          </div>

          <div class="glass-card tier-card">
            <span class="tier-num">Tier 2</span>
            <h4 class="tier-title">🪐 Personal & Social Planets</h4>
            <p class="tier-desc">
              <strong>Mercury</strong> (intellect & communication), <strong>Venus</strong> (values & love), <strong>Mars</strong> (drive), <strong>Jupiter</strong> (expansion), and <strong>Saturn</strong> (discipline).
            </p>
          </div>

          <div class="glass-card tier-card">
            <span class="tier-num">Tier 3</span>
            <h4 class="tier-title">✨ Transits & Long-Term Cycles</h4>
            <p class="tier-desc">
              How current movements of <strong>Saturn, Uranus, Neptune, and Pluto</strong> activate your natal houses to create distinct timing windows and growth phases.
            </p>
          </div>
        </div>

        <!-- App Conversion Callout -->
        <div class="chart-app-box">
          <h3 class="app-box-heading">Get Your Complete Interactive Birth Chart</h3>
          <p class="app-box-text">
            The full AI Zodiac mobile application calculates your exact Ascendant degree, planetary houses, and aspects, rendering an interactive visual chart wheel with tap-to-inspect interpretations.
          </p>
          <a
            href={siteConfig.googlePlayUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary result-app-btn"
          >
            <span>Get AI Zodiac App</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 12 Astrological Houses Preview -->
    <section class="houses-section">
      <div class="section-header">
        <span class="badge badge-gold">Natal Chart Blueprint</span>
        <h2 class="section-title">The 12 Astrological Houses</h2>
        <p class="section-desc">
          In a full birth chart, your exact birth time and location divide the sky into 12 life arenas, showing where each planetary energy expresses itself:
        </p>
      </div>

      <div class="houses-grid">
        {CHART_CATEGORIES.map((cat) => (
          <div class="glass-card house-card">
            <div class="house-header">
              <span class="house-num">{cat.num} House</span>
              <h3 class="house-title">{cat.title}</h3>
            </div>
            <p class="house-focus">{cat.focus}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline define:vars={{ signsData: WESTERN_ZODIAC_SIGNS }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('chart-form');
    const resultBox = document.getElementById('chart-result');
    const chartSignIcon = document.getElementById('chart-sign-icon');
    const sunHeading = document.getElementById('chart-sun-heading');
    const dateDisplay = document.getElementById('chart-date-display');

    function getZodiacSign(month, day) {
      if ((month === 3 && day >= 21) || (month === 4 && day <= 19)) return 'aries';
      if ((month === 4 && day >= 20) || (month === 5 && day <= 20)) return 'taurus';
      if ((month === 5 && day >= 21) || (month === 6 && day <= 20)) return 'gemini';
      if ((month === 6 && day >= 21) || (month === 7 && day <= 22)) return 'cancer';
      if ((month === 7 && day >= 23) || (month === 8 && day <= 22)) return 'leo';
      if ((month === 8 && day >= 23) || (month === 9 && day <= 22)) return 'virgo';
      if ((month === 9 && day >= 23) || (month === 10 && day <= 22)) return 'libra';
      if ((month === 10 && day >= 23) || (month === 11 && day <= 21)) return 'scorpio';
      if ((month === 11 && day >= 22) || (month === 12 && day <= 21)) return 'sagittarius';
      if ((month === 12 && day >= 22) || (month === 1 && day <= 19)) return 'capricorn';
      if ((month === 1 && day >= 20) || (month === 2 && day <= 18)) return 'aquarius';
      return 'pisces';
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const dateVal = document.getElementById('chart-date').value;
      if (!dateVal) return;

      const dateObj = new Date(dateVal + 'T00:00:00');
      const month = dateObj.getMonth() + 1;
      const day = dateObj.getDate();

      const signId = getZodiacSign(month, day);
      const sign = signsData.find((s) => s.id === signId);

      if (sign) {
        if (chartSignIcon) {
          chartSignIcon.src = sign.iconUrl || `/images/ic_${sign.id}.png`;
          chartSignIcon.alt = `${sign.name} Icon`;
        }
        sunHeading.textContent = `Your Core Sun Archetype: ${sign.symbol} ${sign.name}`;
        dateDisplay.textContent = `Birth Date: ${dateObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}`;

        resultBox.style.display = 'block';
        resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
</script>

<style>
  .tool-page {
    max-width: 860px;
    padding: 3.5rem 1.5rem 6rem;
  }

  .tool-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: var(--accent-cyan);
  }

  .divider {
    color: var(--border-subtle);
  }

  .current {
    color: var(--accent-gold);
    font-weight: 500;
  }

  .tool-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .badge-wrap {
    margin-bottom: 1.25rem;
  }

  .tool-title {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .tool-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 660px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* Form */
  .calculator-card {
    padding: 2.5rem 2rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.45) 0%, rgba(16, 22, 47, 0.85) 100%);
    border: 1px solid var(--border-active);
    margin-bottom: 4.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-input {
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-input:focus {
    border-color: var(--accent-purple);
  }

  .input-hint {
    font-size: 0.6875rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .chart-submit-btn {
    width: 100%;
    height: 48px;
  }

  /* Output */
  .chart-result-box {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
    animation: fadeIn 0.4s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chart-banner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .chart-sign-icon {
    width: 56px;
    height: 56px;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(245, 158, 11, 0.3));
    flex-shrink: 0;
  }

  .chart-sun-name {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .chart-date-text {
    font-size: 0.875rem;
    color: var(--accent-gold);
  }

  .preview-explanation {
    margin-bottom: 2.5rem;
  }

  .expl-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
  }

  .expl-text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .highlight-text {
    color: var(--text-primary);
    font-weight: 600;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .tier-card {
    padding: 1.5rem;
  }

  .tier-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .tier-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .tier-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .chart-app-box {
    padding: 2.25rem 2rem;
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.6) 0%, rgba(16, 22, 47, 0.9) 100%);
    border: 1px solid var(--border-active);
    text-align: center;
  }

  .app-box-heading {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .app-box-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  /* Houses Section */
  .houses-section {
    margin-top: 3rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .houses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .house-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .house-header {
    margin-bottom: 0.65rem;
  }

  .house-num {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .house-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .house-focus {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
