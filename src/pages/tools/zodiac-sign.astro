---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WESTERN_ZODIAC_SIGNS } from '@/types/content';
import { buildCanonicalUrl } from '@/lib/seo/meta';
import { siteConfig } from '@/config/site';

const pageUrl = buildCanonicalUrl('tools/zodiac-sign');

const toolJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'AI Zodiac Sign Finder',
  url: pageUrl,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  description: 'Find your exact Western zodiac sign, element, modality, and personality archetype from your birth date.',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title="Zodiac Sign Finder & Personality Calculator — AI Zodiac"
  description="Discover your exact zodiac sign, element, modality, and ruling planet from your birth date. Free, instant astrological archetype finder."
  canonicalUrl={pageUrl}
  jsonLd={toolJsonLd}
>
  <div class="tool-page container">
    <!-- Breadcrumb -->
    <nav class="tool-breadcrumb" aria-label="Breadcrumb">
      <a href="/tools" class="breadcrumb-link">
        <span>←</span> All Tools
      </a>
      <span class="divider">/</span>
      <span class="current">Zodiac Sign Finder</span>
    </nav>

    <!-- Header -->
    <header class="tool-header">
      <div class="badge-wrap">
        <span class="badge badge-gold">✦ Free Calculator</span>
      </div>
      <h1 class="tool-title">
        Zodiac Sign <span class="gradient-text">Finder</span>
      </h1>
      <p class="tool-subtitle">
        Enter your birth date to instantly determine your Western zodiac sign, elemental orientation, modality, and ruling celestial body.
      </p>
    </header>

    <!-- Calculator Card -->
    <div class="glass-card calculator-card">
      <form id="zodiac-form" class="calc-form">
        <div class="form-group">
          <label for="birth-month" class="form-label">Birth Month</label>
          <select id="birth-month" class="form-select" required>
            <option value="">Select Month</option>
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
          </select>
        </div>

        <div class="form-group">
          <label for="birth-day" class="form-label">Birth Day</label>
          <select id="birth-day" class="form-select" required>
            <option value="">Select Day</option>
            {Array.from({ length: 31 }, (_, i) => i + 1).map((d) => (
              <option value={d}>{d}</option>
            ))}
          </select>
        </div>

        <button type="submit" class="btn btn-primary calc-submit-btn">
          Calculate Zodiac Sign <span>→</span>
        </button>
      </form>

      <!-- Result Container -->
      <div id="result-box" class="result-container" style="display: none;">
        <div class="result-header">
          <img id="result-icon-img" src="/images/ic_aries.png" alt="Zodiac Sign Icon" width="64" height="64" class="result-sign-img" />
          <div class="result-title-wrap">
            <h2 id="result-name" class="result-name">Aries</h2>
            <span id="result-dates" class="result-dates">Mar 21 - Apr 19</span>
          </div>
        </div>

        <div class="result-badges">
          <span id="result-element" class="badge">Fire Element</span>
          <span id="result-modality" class="badge">Cardinal Modality</span>
          <span id="result-planet" class="badge badge-gold">Ruler: Mars</span>
        </div>

        <p id="result-desc" class="result-description"></p>

        <div class="traits-wrap">
          <span class="traits-heading">Core Archetype Traits:</span>
          <div id="result-traits" class="traits-chips"></div>
        </div>

        <!-- Conversion Box -->
        <div class="result-app-box">
          <h3 class="app-box-heading">Get Your Complete Birth Chart & Daily Horoscope</h3>
          <p class="app-box-text">
            Your Sun sign is only the conscious foundation. The AI Zodiac Android app calculates your Moon sign, Rising sign, and 10 planetary houses for complete personal guidance.
          </p>
          <a
            href={siteConfig.googlePlayUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary result-app-btn"
          >
            <span>Get AI Zodiac App</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Context Section -->
    <section class="educational-section">
      <h2 class="edu-title">The Twelve Zodiac Archetypes</h2>
      <p class="edu-desc">
        In Western tropical astrology, the twelve zodiac signs correspond to the Sun’s position against the 360-degree celestial ecliptic at the moment of your birth. Each sign represents a unique synthesis of elemental energy and behavioral modality.
      </p>

      <div class="signs-overview-grid">
        {WESTERN_ZODIAC_SIGNS.map((sign) => (
          <div class="glass-card mini-sign-card">
            <div class="mini-sign-top">
              <img src={sign.iconUrl} alt={`${sign.name} Icon`} width="32" height="32" class="mini-sign-icon" loading="lazy" />
              <div class="mini-sign-titles">
                <span class="mini-name">{sign.name}</span>
                <span class="mini-symbol">{sign.symbol}</span>
              </div>
            </div>
            <span class="mini-date">{sign.dateRange}</span>
            <span class="mini-meta">{sign.element} • {sign.modality}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline define:vars={{ signsData: WESTERN_ZODIAC_SIGNS }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('zodiac-form');
    const resultBox = document.getElementById('result-box');

    const resultIconImg = document.getElementById('result-icon-img');
    const resultName = document.getElementById('result-name');
    const resultDates = document.getElementById('result-dates');
    const resultElement = document.getElementById('result-element');
    const resultModality = document.getElementById('result-modality');
    const resultPlanet = document.getElementById('result-planet');
    const resultDesc = document.getElementById('result-desc');
    const resultTraits = document.getElementById('result-traits');

    function displaySign(sign) {
      if (!sign) return;
      if (resultIconImg) {
        resultIconImg.src = sign.iconUrl || `/images/ic_${sign.id}.png`;
        resultIconImg.alt = `${sign.name} Icon`;
      }
      resultName.textContent = sign.name;
      resultDates.textContent = sign.dateRange;
      resultElement.textContent = `${sign.element.charAt(0).toUpperCase() + sign.element.slice(1)} Element`;
      resultModality.textContent = `${sign.modality.charAt(0).toUpperCase() + sign.modality.slice(1)} Modality`;
      resultPlanet.textContent = `Ruler: ${sign.rulingPlanet}`;
      resultDesc.textContent = sign.description;

      resultTraits.innerHTML = '';
      sign.traits.forEach((trait) => {
        const chip = document.createElement('span');
        chip.className = 'trait-chip';
        chip.textContent = trait;
        resultTraits.appendChild(chip);
      });

      resultBox.style.display = 'block';
      resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function getZodiacSign(month, day) {
      if ((month === 3 && day >= 21) || (month === 4 && day <= 19)) return 'aries';
      if ((month === 4 && day >= 20) || (month === 5 && day <= 20)) return 'taurus';
      if ((month === 5 && day >= 21) || (month === 6 && day <= 20)) return 'gemini';
      if ((month === 6 && day >= 21) || (month === 7 && day <= 22)) return 'cancer';
      if ((month === 7 && day >= 23) || (month === 8 && day <= 22)) return 'leo';
      if ((month === 8 && day >= 23) || (month === 9 && day <= 22)) return 'virgo';
      if ((month === 9 && day >= 23) || (month === 10 && day <= 22)) return 'libra';
      if ((month === 10 && day >= 23) || (month === 11 && day <= 21)) return 'scorpio';
      if ((month === 11 && day >= 22) || (month === 12 && day <= 21)) return 'sagittarius';
      if ((month === 12 && day >= 22) || (month === 1 && day <= 19)) return 'capricorn';
      if ((month === 1 && day >= 20) || (month === 2 && day <= 18)) return 'aquarius';
      return 'pisces';
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const month = parseInt(document.getElementById('birth-month').value, 10);
      const day = parseInt(document.getElementById('birth-day').value, 10);

      if (!month || !day) return;

      const signId = getZodiacSign(month, day);
      const sign = signsData.find((s) => s.id === signId);
      displaySign(sign);
    });

    // Check for query param ?sign=
    const params = new URLSearchParams(window.location.search);
    const querySign = params.get('sign');
    if (querySign) {
      const matched = signsData.find((s) => s.id === querySign.toLowerCase());
      if (matched) {
        displaySign(matched);
      }
    }
  });
</script>

<style>
  .tool-page {
    max-width: 820px;
    padding: 3.5rem 1.5rem 6rem;
  }

  /* Breadcrumb */
  .tool-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: var(--accent-cyan);
  }

  .divider {
    color: var(--border-subtle);
  }

  .current {
    color: var(--accent-gold);
    font-weight: 500;
  }

  /* Header */
  .tool-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .badge-wrap {
    margin-bottom: 1.25rem;
  }

  .tool-title {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .tool-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* Calculator Card */
  .calculator-card {
    padding: 2.5rem 2rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.45) 0%, rgba(16, 22, 47, 0.85) 100%);
    border: 1px solid var(--border-active);
    margin-bottom: 4.5rem;
  }

  .calc-form {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1.25rem;
    align-items: flex-end;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-select {
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-select:focus {
    border-color: var(--accent-purple);
  }

  .calc-submit-btn {
    height: 46px;
    padding: 0 1.5rem;
  }

  /* Result Container */
  .result-container {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
    animation: fadeIn 0.4s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .result-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .result-sign-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(245, 158, 11, 0.3));
    flex-shrink: 0;
  }

  .result-name {
    font-size: 2rem;
    font-weight: 800;
  }

  .result-dates {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .result-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .result-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .traits-wrap {
    margin-bottom: 2.5rem;
  }

  .traits-heading {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-highlight);
    margin-bottom: 0.75rem;
  }

  .traits-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.trait-chip) {
    font-size: 0.8125rem;
    color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
  }

  /* App Box */
  .result-app-box {
    padding: 2.25rem 2rem;
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.6) 0%, rgba(16, 22, 47, 0.9) 100%);
    border: 1px solid var(--border-active);
    text-align: center;
  }

  .app-box-heading {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .app-box-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  .result-app-btn {
    padding: 0.75rem 2rem;
  }

  /* Educational Section */
  .educational-section {
    margin-top: 2rem;
  }

  .edu-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .edu-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .signs-overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 1rem;
  }

  .mini-sign-card {
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .mini-sign-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .mini-sign-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .mini-sign-titles {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .mini-symbol {
    font-size: 1rem;
    color: var(--accent-gold);
  }

  .mini-name {
    font-size: 1rem;
    font-weight: 700;
  }

  .mini-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .mini-meta {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-cyan);
  }

  @media (max-width: 640px) {
    .calc-form {
      grid-template-columns: 1fr;
    }
  }
</style>
