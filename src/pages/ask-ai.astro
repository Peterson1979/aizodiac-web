---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCanonicalUrl } from '@/lib/seo/meta';
import { siteConfig } from '@/config/site';

const pageUrl = buildCanonicalUrl('ask-ai');

const askAiJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Ask the AI Astrologer — AI Zodiac',
  url: pageUrl,
  description: 'Ask your astrology questions and receive personalized AI-powered guidance based on your profile and zodiac information in the AI Zodiac Android app.',
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.getBaseUrl(),
  },
};

const SAMPLE_QUESTIONS = [
  {
    category: 'Career & Timing',
    icon: '🧭',
    question: '“What does my current astrological cycle mean for my career and personal growth over the coming months?”',
    context: 'Explores your zodiac sign, planetary influences, and life timing for career pacing and opportunities.',
  },
  {
    category: 'Love & Relationships',
    icon: '💖',
    question: '“How do my astrological traits affect communication and connection with my partner?”',
    context: 'Explores your zodiac strengths, emotional tendencies, and actionable harmony tips.',
  },
  {
    category: 'Personal Timing',
    icon: '🌙',
    question: '“What should I focus on during this month’s cosmic cycle and lunar phase?”',
    context: 'Highlights timing, self-reflection themes, and practical personal guidance.',
  },
  {
    category: 'Self-Discovery & Strengths',
    icon: '🔮',
    question: '“What are my greatest personality strengths and areas for personal growth according to my sign?”',
    context: 'Provides deep, personalized insights into your natural talents and character traits.',
  },
];
---

<BaseLayout
  title="Ask the AI Astrologer — AI Zodiac App"
  description="Ask your astrology questions and receive personalized AI-powered guidance based on your profile and zodiac information in the AI Zodiac Android app."
  canonicalUrl={pageUrl}
  jsonLd={askAiJsonLd}
>
  <div class="ask-ai-page container">
    <!-- Hero Header -->
    <header class="ask-hero">
      <div class="icon-box-hero" style="margin: 0 auto 1.5rem;">
        <img src="/images/ic_question.png" alt="Ask AI Astrologer" class="icon-img-hero" width="56" height="56" />
      </div>
      <div class="badge-wrap">
        <span class="badge badge-gold">✦ Astrological Guidance</span>
      </div>
      <h1 class="ask-title">
        Ask the <span class="gradient-text">AI Astrologer</span>
      </h1>
      <p class="ask-subtitle">
        Ask your astrology questions and receive personalized AI-powered guidance based on your profile and zodiac information.
      </p>

      <div class="ask-hero-actions">
        <a
          href={siteConfig.googlePlayUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-play"
          aria-label="Get AI Zodiac App on Google Play"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
          </svg>
          <div class="btn-play-text">
            <span class="btn-play-sub">GET IT ON</span>
            <span class="btn-play-main">Google Play</span>
          </div>
        </a>
        <a href="/features" class="btn btn-secondary">
          Explore All Features
        </a>
      </div>
    </header>

    <!-- Consumer-Focused How It Works Section -->
    <section class="how-it-works-section">
      <div class="glass-card how-card">
        <div class="how-header">
          <span class="badge badge-gold">✦ Personalized Astrology Experience</span>
          <h2 class="how-title">How Ask AI Works in AI Zodiac</h2>
          <p class="how-intro">
            Get personalized astrological answers tailored to your exact zodiac profile and personal birth details anytime inside the Android app.
          </p>
        </div>

        <div class="how-grid">
          <div class="glass-card step-card">
            <div class="step-badge">01</div>
            <h3 class="step-title">Ask Any Question</h3>
            <p class="step-desc">
              Ask about your daily outlook, love compatibility, career timing, strengths, or personal life in clear, natural language.
            </p>
          </div>

          <div class="glass-card step-card">
            <div class="step-badge">02</div>
            <h3 class="step-title">Personalized to Your Profile</h3>
            <p class="step-desc">
              AI Zodiac uses your specific zodiac sign, birth details, and personal astrological information to deliver meaningful, tailored guidance.
            </p>
          </div>

          <div class="glass-card step-card">
            <div class="step-badge">03</div>
            <h3 class="step-title">Continue in the Mobile App</h3>
            <p class="step-desc">
              Experience the full interactive conversational AI astrologer privately in the AI Zodiac Android app whenever you need clarity.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Example Questions Section -->
    <section class="questions-section">
      <div class="section-header">
        <span class="badge badge-gold">✦ Example Questions</span>
        <h2 class="section-title">What You Can Ask the AI Astrologer</h2>
        <p class="section-desc">
          From understanding personal timing to relationship dynamics, here are examples of questions you can explore:
        </p>
      </div>

      <div class="questions-grid">
        {SAMPLE_QUESTIONS.map((item) => (
          <div class="glass-card question-card">
            <div class="q-header">
              <span class="q-icon">{item.icon}</span>
              <span class="q-category">{item.category}</span>
            </div>
            <p class="q-prompt">{item.question}</p>
            <div class="q-context">
              <span class="context-label">Astrological Focus:</span>
              <p class="context-text">{item.context}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- App Conversion Section -->
    <section class="ask-app-conversion">
      <div class="glass-card app-card">
        <div class="app-card-brand">
          <img src="/images/aizodiac_logo.png" alt="AI Zodiac Logo" width="56" height="56" class="app-card-logo-img" />
        </div>
        <span class="badge badge-gold">AI Zodiac Android App</span>
        <h2 class="app-card-title">Ask Your Questions in the AI Zodiac App</h2>
        <p class="app-card-desc">
          Download the AI Zodiac Android app to ask your personal questions and receive personalized AI-powered guidance based on your profile and zodiac information.
        </p>
        <div class="app-card-actions">
          <a
            href={siteConfig.googlePlayUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-play app-cta-btn"
            aria-label="Get AI Zodiac App on Google Play"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
            </svg>
            <div class="btn-play-text">
              <span class="btn-play-sub">GET IT ON</span>
              <span class="btn-play-main">Google Play</span>
            </div>
          </a>
        </div>
        <span class="app-card-note">
          Free download on Google Play • Personalized horoscope and astrology insights
        </span>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ask-ai-page {
    max-width: 880px;
    padding: 4rem 1.5rem 6rem;
  }

  /* Hero */
  .ask-hero {
    text-align: center;
    margin-bottom: 4.5rem;
  }

  .badge-wrap {
    margin-bottom: 1.25rem;
  }

  .ask-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .ask-subtitle {
    font-size: 1.1875rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .ask-hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* How It Works Section */
  .how-it-works-section {
    margin-bottom: 5rem;
  }

  .how-card {
    padding: 3rem 2.5rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.5) 0%, rgba(16, 22, 47, 0.85) 100%);
    border: 1px solid var(--border-active);
  }

  .how-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .how-title {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .how-intro {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .step-card {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-subtle);
  }

  .step-badge {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent-gold);
    margin-bottom: 0.75rem;
  }

  .step-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .step-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Questions Grid */
  .questions-section {
    margin-bottom: 5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .questions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .question-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .q-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .q-icon {
    font-size: 1.25rem;
  }

  .q-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
  }

  .q-prompt {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .q-context {
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .context-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.35rem;
  }

  .context-text {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* App Conversion */
  .ask-app-conversion {
    margin-top: 2rem;
  }

  .app-card {
    text-align: center;
    padding: 3.5rem 2rem;
    background: linear-gradient(180deg, rgba(26, 34, 70, 0.45) 0%, rgba(16, 22, 47, 0.9) 100%);
    border: 1px solid var(--border-active);
  }

  .app-card-brand {
    margin-bottom: 1.25rem;
  }

  .app-card-logo-img {
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(139, 92, 246, 0.35);
  }

  .app-card-title {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    margin-bottom: 0.85rem;
  }

  .app-card-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 580px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .app-card-actions {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .app-cta-btn {
    padding: 0.85rem 2rem;
  }

  .app-card-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
    display: block;
  }

  @media (max-width: 720px) {
    .how-card {
      padding: 2.25rem 1.5rem;
    }
    .questions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
