---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ZODIAC_SIGN_HUBS_LIST } from '@/data/zodiacSigns';
import { buildCanonicalUrl } from '@/lib/seo/meta';
import ContextualLink from '@/components/cta/ContextualLink.astro';
import FeatureCtaCard from '@/components/cta/FeatureCtaCard.astro';
import { FEATURE_CTA_MAPPINGS } from '@/lib/conversion/ctaMapper';

const canonicalUrl = buildCanonicalUrl('zodiac-signs');

const elements = [
  { id: 'fire', name: 'Fire Signs', desc: 'Passionate, dynamic, and intuitive initiators', signs: ZODIAC_SIGN_HUBS_LIST.filter(s => s.element === 'fire'), color: 'rgba(239, 68, 68, 0.2)' },
  { id: 'earth', name: 'Earth Signs', desc: 'Grounded, practical, and enduring builders', signs: ZODIAC_SIGN_HUBS_LIST.filter(s => s.element === 'earth'), color: 'rgba(34, 197, 94, 0.2)' },
  { id: 'air', name: 'Air Signs', desc: 'Intellectual, communicative, and visionary connectors', signs: ZODIAC_SIGN_HUBS_LIST.filter(s => s.element === 'air'), color: 'rgba(56, 189, 248, 0.2)' },
  { id: 'water', name: 'Water Signs', desc: 'Empathetic, intuitive, and soulful transformers', signs: ZODIAC_SIGN_HUBS_LIST.filter(s => s.element === 'water'), color: 'rgba(168, 85, 247, 0.2)' },
];
---

<BaseLayout
  title="12 Zodiac Signs: Personality Traits, Dates & Love Compatibility | AI Zodiac"
  description="Explore comprehensive guides for all 12 Western zodiac signs. Discover core personality traits, dates, elements, ruling planets, and love compatibility in AI Zodiac."
  canonicalUrl={canonicalUrl}
>
  <div class="zodiac-index-page container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/" class="breadcrumb-link">Home</a>
      <span class="breadcrumb-divider">/</span>
      <span class="breadcrumb-current">Zodiac Signs</span>
    </nav>

    <!-- Header -->
    <header class="page-header">
      <div class="badge-wrap">
        <span class="badge badge-gold">✦ Astrology Archetypes Hub</span>
      </div>
      <h1 class="page-title">The 12 Zodiac Signs</h1>
      <p class="page-lead">
        Explore in-depth personality profiles, elemental dynamics, love compatibility, and daily guidance for every sign in the Western astrological zodiac.
      </p>

      <!-- Quick Action Utilities -->
      <div class="quick-utilities-grid">
        <ContextualLink
          href="/tools/zodiac-sign"
          title="Calculate Your Sun Sign"
          description="Enter your birth date to instantly discover your zodiac sign, element, and modality."
          badge="Free Tool"
          icon="🧭"
        />
        <ContextualLink
          href="/compatibility"
          title="Zodiac Compatibility Hub"
          description="Explore elemental chemistry and relationship dynamics between all sign pairings."
          badge="Synastry"
          icon="❤️"
        />
        <ContextualLink
          href="/horoscopes"
          title="Daily & Monthly Horoscopes"
          description="Explore recurring forecasts and personalized cosmic timing for your sign."
          badge="Forecasts"
          icon="🔮"
        />
      </div>
    </header>

    <!-- Elemental Groups Section -->
    <section class="elements-section">
      {elements.map((elem) => (
        <div class="element-block">
          <div class="element-header">
            <h2 class="element-title">{elem.name}</h2>
            <p class="element-desc">{elem.desc}</p>
          </div>

          <div class="signs-grid">
            {elem.signs.map((sign) => (
              <a href={`/zodiac-signs/${sign.id}`} class="sign-hub-card glass-card">
                <div class="card-top-row">
                  <div class="sign-icon-box">
                    <img src={sign.iconUrl} alt={`${sign.name} Icon`} width="44" height="44" class="sign-img" loading="lazy" />
                  </div>
                  <span class="sign-symbol" title={sign.name}>{sign.symbol}</span>
                </div>

                <div class="sign-info">
                  <h3 class="sign-name">{sign.name}</h3>
                  <span class="sign-dates">{sign.dateRange}</span>
                </div>

                <p class="sign-snippet">{sign.description}</p>

                <div class="sign-meta-tags">
                  <span class="tag-pill">{sign.modality}</span>
                  <span class="tag-pill">Ruler: {sign.rulingPlanet}</span>
                </div>

                <div class="card-footer-link">
                  <span>Explore {sign.name} Profile</span>
                  <span>→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Acquisition CTA -->
    <FeatureCtaCard
      mapping={FEATURE_CTA_MAPPINGS.zodiac_traits}
      locationTag="zodiac_index_bottom_cta"
      secondaryHref="/tools/zodiac-sign"
      secondaryText="Try Free Sign Calculator"
    />
  </div>
</BaseLayout>

<style>
  .zodiac-index-page {
    padding: 3rem 1.5rem 6rem;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
  }

  .breadcrumb-link:hover {
    color: var(--accent-cyan);
  }

  .breadcrumb-divider {
    color: var(--text-muted);
  }

  .breadcrumb-current {
    color: var(--accent-gold);
    font-weight: 500;
  }

  .page-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 4rem;
  }

  .badge-wrap {
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  .quick-utilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    text-align: left;
  }

  .elements-section {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .element-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .element-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .element-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .element-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .signs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .sign-hub-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .sign-hub-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-active);
    box-shadow: var(--shadow-glow);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .sign-icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sign-symbol {
    font-size: 2rem;
    color: var(--accent-gold);
    line-height: 1;
  }

  .sign-info {
    margin-bottom: 0.85rem;
  }

  .sign-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .sign-dates {
    font-size: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 500;
  }

  .sign-snippet {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .sign-meta-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .tag-pill {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    text-transform: capitalize;
  }

  .card-footer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-cyan);
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 960px) {
    .quick-utilities-grid {
      grid-template-columns: 1fr;
    }
    .signs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 2.25rem;
    }
    .signs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
