---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) — AI Zodiac"
  description="The celestial coordinates you requested could not be located in the cosmic map."
  noindex={true}
>
  <div class="container not-found-container">
    <div class="glass-card not-found-card">
      <div class="astrological-glyph">✦ 404 ✦</div>
      <h1 class="not-found-title">Lost in the <span class="gradient-text">Cosmos</span></h1>
      <p class="not-found-desc">
        The celestial body or page you are searching for has drifted into void-of-course territory. Let us guide you back to familiar constellations.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn btn-primary">
          Return to AI Zodiac Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem;
  }

  .not-found-card {
    max-width: 580px;
    width: 100%;
    text-align: center;
    padding: 3.5rem 2.5rem;
  }

  .astrological-glyph {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--accent-gold);
    margin-bottom: 1.25rem;
  }

  .not-found-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1.25rem;
  }

  .not-found-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.25rem;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
  }
</style>
