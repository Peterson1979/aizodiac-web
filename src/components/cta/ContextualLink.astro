---
export interface Props {
  href: string;
  title: string;
  description?: string;
  badge?: string;
  icon?: string;
  direction?: 'forward' | 'none';
  class?: string;
}

const {
  href,
  title,
  description,
  badge,
  icon,
  direction = 'forward',
  class: className = '',
} = Astro.props;
---

<a href={href} class={`contextual-link-card ${className}`}>
  <div class="contextual-content">
    {badge && <span class="contextual-badge">{badge}</span>}
    <div class="contextual-header">
      {icon && <span class="contextual-icon">{icon}</span>}
      <h4 class="contextual-title">{title}</h4>
    </div>
    {description && <p class="contextual-desc">{description}</p>}
  </div>
  {direction === 'forward' && (
    <div class="contextual-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </div>
  )}
</a>

<style>
  .contextual-link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(15, 22, 47, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .contextual-link-card:hover {
    background: rgba(24, 32, 68, 0.85);
    border-color: var(--border-active);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .contextual-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contextual-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-gold);
  }

  .contextual-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contextual-icon {
    font-size: 1.1rem;
  }

  .contextual-title {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .contextual-link-card:hover .contextual-title {
    color: var(--accent-cyan);
  }

  .contextual-desc {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .contextual-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .contextual-link-card:hover .contextual-arrow {
    color: var(--accent-cyan);
    transform: translateX(4px);
  }
</style>
