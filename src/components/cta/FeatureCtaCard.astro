---
import type { FeatureCtaMapping } from '@/types/content';
import { buildAttributedPlayStoreUrl } from '@/lib/conversion/ctaMapper';

export interface Props {
  mapping: FeatureCtaMapping;
  locationTag?: string;
  secondaryHref?: string;
  secondaryText?: string;
  class?: string;
}

const {
  mapping,
  locationTag = 'feature_cta_card',
  secondaryHref = `/features/${mapping.featureSlug}`,
  secondaryText = 'Explore Feature Details',
  class: className = '',
} = Astro.props;

const playStoreUrl = buildAttributedPlayStoreUrl({
  campaign: mapping.utmCampaign,
  placement: locationTag,
});
---

<section class={`feature-cta-section ${className}`}>
  <div class="glass-card feature-cta-card">
    <div class="cta-layout">
      <!-- Icon / Visual Identity -->
      <div class="cta-icon-wrap">
        <div class="icon-box-lg">
          <img src={mapping.icon} alt={`${mapping.title} Icon`} width="64" height="64" class="cta-feature-icon" loading="lazy" />
        </div>
      </div>

      <!-- Main Copy & Value Propositions -->
      <div class="cta-body">
        <div class="cta-badge-row">
          <span class="badge badge-gold">{mapping.badge}</span>
          <span class="badge badge-subtle">Android App</span>
        </div>

        <h3 class="cta-headline">{mapping.headline}</h3>
        <p class="cta-description">{mapping.description}</p>

        {mapping.valueHighlights && mapping.valueHighlights.length > 0 && (
          <ul class="cta-highlights-list">
            {mapping.valueHighlights.map((highlight) => (
              <li class="cta-highlight-item">
                <span class="check-icon" aria-hidden="true">✦</span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        )}

        <!-- Action CTAs: Primary Level 3 Play Store + Secondary Level 2 Internal Feature Link -->
        <div class="cta-actions-row">
          <a
            href={playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-play cta-primary-play"
            data-location={locationTag}
            aria-label={`Get AI Zodiac App on Google Play — ${mapping.title}`}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
            </svg>
            <div class="btn-play-text">
              <span class="btn-play-sub">GET IT ON</span>
              <span class="btn-play-main">Google Play</span>
            </div>
          </a>

          {secondaryHref && (
            <a href={secondaryHref} class="btn btn-secondary cta-secondary-btn">
              <span>{secondaryText}</span>
              <span>→</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-cta-section {
    margin: 3.5rem 0;
    width: 100%;
  }

  .feature-cta-card {
    padding: 2.25rem 2.5rem;
    background: var(--grad-surface);
    border: 1px solid var(--border-active);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glow);
    position: relative;
    overflow: hidden;
  }

  .feature-cta-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.18), transparent 70%);
    pointer-events: none;
  }

  .cta-layout {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .cta-icon-wrap {
    flex-shrink: 0;
  }

  .icon-box-lg {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-md);
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .cta-feature-icon {
    object-fit: contain;
  }

  .cta-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cta-badge-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .badge-subtle {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .cta-headline {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0;
  }

  .cta-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .cta-highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.35rem 0;
  }

  .cta-highlight-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--text-highlight);
  }

  .check-icon {
    color: var(--accent-gold);
    font-size: 0.9rem;
  }

  .cta-actions-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .cta-primary-play {
    padding: 0.65rem 1.4rem;
  }

  .cta-secondary-btn {
    padding: 0.75rem 1.35rem;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .feature-cta-card {
      padding: 1.75rem 1.5rem;
    }
    .cta-layout {
      flex-direction: column;
      gap: 1.25rem;
    }
    .cta-headline {
      font-size: 1.15rem;
    }
    .cta-actions-row {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-primary-play, .cta-secondary-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
