---
import { siteConfig } from '@/config/site';
import { buildPlayStoreUrl } from '@/lib/conversion/playStore';

const headerPlayStoreUrl = buildPlayStoreUrl({
  utmSource: 'website',
  utmMedium: 'navigation',
  utmCampaign: 'global_header',
  utmContent: 'header_btn',
});

const mobileDrawerPlayStoreUrl = buildPlayStoreUrl({
  utmSource: 'website',
  utmMedium: 'navigation',
  utmCampaign: 'global_header',
  utmContent: 'mobile_drawer_btn',
});
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="AI Zodiac Home">
      <img src="/images/aizodiac_logo.png" alt="AI Zodiac Logo" width="40" height="40" class="brand-icon" />
      <span class="brand-name">{siteConfig.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links desktop-nav" aria-label="Main Navigation">
      <a href="/features" class="nav-item">Features</a>
      <a href="/tools" class="nav-item">Free Tools</a>
      <a href="/ask-ai" class="nav-item">Ask AI</a>
      <a href="/articles" class="nav-item">Guides</a>
    </nav>

    <div class="header-actions">
      <a
        href={headerPlayStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary header-btn"
        data-location="header"
        aria-label="Get AI Zodiac App on Google Play"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
        </svg>
        <span>Get AI Zodiac App</span>
      </a>

      <!-- Mobile Hamburger Toggle Button -->
      <button
        id="mobile-menu-toggle"
        class="mobile-toggle-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        type="button"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Drawer -->
  <div id="mobile-nav-menu" class="mobile-nav-drawer" aria-hidden="true">
    <nav class="mobile-nav-list" aria-label="Mobile Navigation">
      <a href="/features" class="mobile-nav-link">
        <span class="nav-icon">✦</span>
        <span>Features</span>
      </a>
      <a href="/tools" class="mobile-nav-link">
        <span class="nav-icon">🧭</span>
        <span>Free Tools</span>
      </a>
      <a href="/ask-ai" class="mobile-nav-link">
        <span class="nav-icon">🔮</span>
        <span>Ask AI</span>
      </a>
      <a href="/articles" class="mobile-nav-link">
        <span class="nav-icon">📖</span>
        <span>Guides</span>
      </a>

      <div class="mobile-nav-cta-wrap">
        <a
          href={mobileDrawerPlayStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-play mobile-play-btn"
          data-location="mobile_drawer"
          aria-label="Get AI Zodiac App on Google Play"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a2.032 2.032 0 0 1-.22-.988V2.802c0-.363.078-.7.219-.988zM15.207 13.414l2.673 2.673-12.87 7.377 10.197-10.05zm0-2.828L5.01 0.536l12.87 7.377-2.673 2.673zm1.414 1.414l3.18-1.82a1.86 1.86 0 0 1 0 3.232l-3.18-1.812z"/>
          </svg>
          <div class="btn-play-text">
            <span class="btn-play-sub">GET IT ON</span>
            <span class="btn-play-main">Google Play</span>
          </div>
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-nav-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      toggleBtn.classList.toggle('is-active', !isExpanded);
      mobileMenu.classList.toggle('is-open', !isExpanded);
      mobileMenu.setAttribute('aria-hidden', String(isExpanded));
    });

    // Close when clicking a link inside mobile drawer
    const links = mobileMenu.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.classList.remove('is-active');
        mobileMenu.classList.remove('is-open');
        mobileMenu.setAttribute('aria-hidden', 'true');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(7, 10, 23, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-glass);
    transition: background-color var(--transition-normal);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.75rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-icon {
    border-radius: var(--radius-sm);
    transition: transform var(--transition-normal);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
  }

  .brand-link:hover .brand-icon {
    transform: rotate(12deg) scale(1.08);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-item {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .nav-item:hover {
    color: var(--accent-cyan);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-btn {
    padding: 0.6rem 1.35rem;
    font-size: 0.875rem;
  }

  /* Hamburger Button */
  .mobile-toggle-btn {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 42px;
    height: 42px;
    padding: 10px 8px;
    background: rgba(26, 34, 70, 0.6);
    border: 1px solid var(--border-active);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-toggle-btn:hover {
    background: rgba(139, 92, 246, 0.2);
    border-color: var(--accent-gold);
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: transform var(--transition-normal), opacity var(--transition-normal);
  }

  /* Hamburger Active Animation (X Shape) */
  .mobile-toggle-btn.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .mobile-toggle-btn.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle-btn.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    display: none;
    max-height: 0;
    overflow: hidden;
    background: rgba(6, 9, 20, 0.98);
    border-bottom: 1px solid var(--border-active);
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    opacity: 0;
  }

  .mobile-nav-drawer.is-open {
    max-height: 400px;
    opacity: 1;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem 1.75rem;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .mobile-nav-link:hover {
    background: rgba(139, 92, 246, 0.15);
    color: var(--accent-cyan);
    border-color: var(--border-active);
  }

  .nav-icon {
    font-size: 1.15rem;
    color: var(--accent-gold);
  }

  .mobile-nav-cta-wrap {
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-play-btn {
    width: 100%;
    justify-content: center;
    padding: 0.75rem 1.5rem;
  }

  @media (max-width: 820px) {
    .site-header {
      background: rgba(7, 10, 23, 0.82);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-toggle-btn {
      display: flex;
    }
    .mobile-nav-drawer {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .header-btn {
      display: none;
    }
    .brand-name {
      font-size: 1.15rem;
    }
    .header-inner {
      height: 4.25rem;
    }
  }
</style>
