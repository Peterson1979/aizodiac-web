---
import { siteConfig } from '@/config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Mission -->
      <div class="footer-brand-col">
        <div class="footer-brand">
          <img src="/favicon.svg" alt="AI Zodiac Logo" width="32" height="32" />
          <span class="brand-name">{siteConfig.name}</span>
        </div>
        <p class="footer-tagline">
          Personalized astrological intelligence combining precision celestial mechanics with modern AI models for self-reflection and relationship understanding.
        </p>
      </div>

      <!-- App Features -->
      <div class="footer-col">
        <h3 class="footer-heading">Features</h3>
        <ul class="footer-list">
          <li><a href="/features/personal-horoscope" class="footer-link">Personal Horoscope</a></li>
          <li><a href="/features/birth-chart" class="footer-link">Birth Chart Synthesis</a></li>
          <li><a href="/features/ask-ai" class="footer-link">Ask the AI Astrologer</a></li>
          <li><a href="/features/love-compatibility" class="footer-link">Love Compatibility</a></li>
          <li><a href="/features/numerology" class="footer-link">Numerology Alignments</a></li>
          <li><a href="/features/ascendant" class="footer-link">Ascendant Insights</a></li>
          <li><a href="/features/chinese-horoscope" class="footer-link">Chinese Horoscope</a></li>
        </ul>
      </div>

      <!-- Interactive Tools -->
      <div class="footer-col">
        <h3 class="footer-heading">Tools</h3>
        <ul class="footer-list">
          <li><a href="/tools" class="footer-link">All Free Calculators</a></li>
          <li><a href="/tools/zodiac-sign" class="footer-link">Zodiac Sign Finder</a></li>
          <li><a href="/tools/compatibility" class="footer-link">Compatibility Preview</a></li>
          <li><a href="/tools/birth-chart" class="footer-link">Birth Chart Preview</a></li>
          <li><a href="/ask-ai" class="footer-link">Ask the AI Overview</a></li>
        </ul>
      </div>

      <!-- Guides & Ecosystem -->
      <div class="footer-col">
        <h3 class="footer-heading">Guides & Site</h3>
        <ul class="footer-list">
          <li><a href="/articles" class="footer-link">All Astrology Guides</a></li>
          <li><a href="/#zodiac" class="footer-link">12 Zodiac Signs</a></li>
          <li><a href="/sitemap-index.xml" class="footer-link">Sitemap</a></li>
          <li><a href="/robots.txt" class="footer-link">Robots.txt</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} {siteConfig.name}. Designed for thoughtful self-discovery.
      </p>
      <div class="footer-note">
        <span class="badge badge-gold">Empowering Astrological Clarity</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-glass);
    background: var(--bg-darkest);
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .footer-tagline {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 340px;
    line-height: 1.65;
  }

  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-highlight);
    margin-bottom: 1.25rem;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--accent-cyan);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .footer-brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>
